# .env.example - contains no real credentials.
# Copy this file to .env (which is git-ignored) and replace the placeholders.
COHERE_API_KEY=YOUR_LOCAL_COHERE_KEY_HERE
PERENUAL_API_KEY=YOUR_LOCAL_PERENUAL_KEY_HERE
PLANTNET_API_KEY=YOUR_LOCAL_PLANTNET_KEY_HERE
# Optional: override the Cohere chat model (default: command-a-03-2025)
# COHERE_MODEL=command-a-03-2025
# Optional: override the Cohere vision model used for plant and timetable photos
# COHERE_VISION_MODEL=command-a-vision-07-2025
